{
    "display_information": {
        "name": "Slack AI Assistant",
        "description": "AI-powered assistant with RAG, Memory, and MCP integration",
        "background_color": "#4A154B"
    },
    "features": {
        "bot_user": {
            "display_name": "AI Assistant",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "channels:history",
                "channels:read",
                "chat:write",
                "im:history",
                "im:read",
                "im:write",
                "reactions:read",
                "reactions:write",
                "users:read",
                "groups:history",
                "groups:read",
                "mpim:history",
                "mpim:read"
            ],
            "user": [
                "reminders:read",
                "reminders:write"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "message.im",
                "message.channels",
                "message.groups",
                "message.mpim",
                "reaction_added"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}